{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.iZoy/arshy",
  "title": "Arshy",
  "description": "Local command execution for agents with structured build, test, and lint diagnostics.",
  "version": "0.1.0-alpha.1",
  "repository": {
    "url": "https://github.com/iZoy/Arshy",
    "source": "github"
  },
  "websiteUrl": "https://github.com/iZoy/Arshy",
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "arshy",
      "version": "0.1.0-alpha.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "positional", "value": "serve" }
      ]
    }
  ]
}
